---
import { structureSvg, type Structure } from '../lib/data';
interface Props { m: Structure; smiles?: boolean }
const { m, smiles = true } = Astro.props;
---
<figure class="mol" id={`mol-${m.id}`} style="margin:0">
  <div class="art" set:html={structureSvg(m.id)} />
  <h4>{m.name}</h4>
  <p>{m.role}</p>
  {smiles && <code title="SMILES">{m.smiles}</code>}
</figure>
